# Copy to .streamlit/secrets.toml (gitignored) and replace the placeholders.
# On Streamlit Community Cloud, paste the same names/values in App settings > Secrets.
LLM_PROVIDER = "anthropic"
LLM_MODEL = "claude-haiku-4-5"
ANTHROPIC_API_KEY = "your-anthropic-key-here"
OPENAI_API_KEY = "your-openai-key-here"
DAILY_QUESTION_CAP = 200
